# Зависимости (удаляем node_modules отовсюду)
node_modules/
**/node_modules/

# Папки сборки (директории билда фронтенда)
dist/
**/dist/
.vite/
**/.vite/

# Логи и кэш
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/

# Локальные переменные окружения (конфиденциальные данные)
.env
.env.local
.env.*.local
# Токен Cloudflare Tunnel (шаблон .env.cloudflare.example — в git)
.env.cloudflare

# Системные файлы
.DS_Store
Thumbs.db
# Generated certificates and personal photos
storage/certificates/*.sqlite
storage/certificates/*.sqlite-*
storage/certificates/registry.json
storage/certificates/photos/*
!storage/certificates/photos/.gitkeep
storage/certificates/generated/*
!storage/certificates/generated/.gitkeep
# Warehouse database (regenerated/seeded on startup)
storage/warehouse/*.sqlite
storage/warehouse/*.sqlite-*
# Logistics database (regenerated/seeded on startup)
storage/logistics/*.sqlite
storage/logistics/*.sqlite-*
# Employee directory (provisioned just-in-time from Cloudflare Access; holds
# staff emails and their elections roles)
storage/employees/*.sqlite
storage/employees/*.sqlite-*
# Elections: the campaign database holds real contact details of residents, and
# the attachments directory holds photographs taken in the field. Neither ever
# belongs in the repository — the database is rebuilt with
# `tsx src/scripts/import-osm-snapshot.ts`.
storage/elections/*.sqlite
storage/elections/*.sqlite-*
storage/elections/attachments/*
!storage/elections/attachments/.gitkeep
storage/backups/
runtime/



# Local tool / pnpm cache
.tools/pnpm-store/
.tools/**/pnpm-store/

# Local tools and caches
.tools/

# Vite check/build artifacts
apps/web/.vite-cert-check/
apps/web/vite-*.log
apps/web/certificates-screenshot.png

.pnpm-store/

# Playwright E2E artifacts: traces, HAR/network logs, HTML report.
apps/web/e2e-results/
apps/web/e2e-report/
# Cloudflare Access session state. Never commit — it is a bearer credential.
**/*.storageState.json
apps/web/.auth/
