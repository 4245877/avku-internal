# Explicitly allow only versioned build resources. Runtime data, private imports,
# credentials, Git history and local tools never enter the build context.
**
!apps/
apps/*
!apps/api/
apps/api/*
!apps/api/Dockerfile
!apps/api/docker-entrypoint.sh
!apps/api/package.json
!apps/api/pnpm-lock.yaml
!apps/api/pnpm-workspace.yaml
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
apps/web/*
!apps/web/Dockerfile
!apps/web/package.json
!apps/web/pnpm-lock.yaml
!apps/web/vite.config.js
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!infra/
infra/*
!infra/node/
infra/node/*
!infra/node/Dockerfile
!infra/node/fonts.conf
!infra/nginx/
infra/nginx/*
!infra/nginx/*.conf
!infra/certificate-backup/
infra/certificate-backup/*
!infra/certificate-backup/extract.py
!storage/
storage/*
!storage/certificates/
storage/certificates/*
!storage/certificates/templates/
!storage/certificates/templates/**
!.dockerignore

# Defense in depth even under an explicitly included source directory.
**/node_modules
**/.git
**/.env
**/.env.*
**/*.sqlite*
**/*.docx
**/__pycache__
**/*.pyc
