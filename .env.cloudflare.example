# Шаблон переменных для docker-compose.cloudflared.yml.
#
# Использование:
#   1. cp .env.cloudflare.example .env.cloudflare
#   2. chmod 600 .env.cloudflare
#   3. Вставить токен туннеля из Cloudflare Zero Trust
#      (Networks -> Tunnels -> <туннель> -> кнопка с docker-командой содержит токен,
#       либо Install connector -> скопировать значение после "--token").
#
# .env.cloudflare НЕ коммитить: он в .gitignore. Токен даёт право поднять
# коннектор туннеля от имени вашего аккаунта.

CLOUDFLARE_TUNNEL_TOKEN=
